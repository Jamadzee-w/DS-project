%matplotlib inline
import pandas as pd, matplotlib.pyplot as plt, matplotlib.patches as mpatches, matplotlib.ticker as mticker
plt.rcParams['figure.dpi'] = 110
TEAL = '#01696f'; ORANGE = '#e07b39'; TEAL3 = '#a8d5d1'

# ── ДАННЫЕ из parser.py (MOCK_DATA) ─────────────────────────────────────────
tariffs = pd.DataFrame([
    {'company_name':'СДЭК',    'destination':'Казань',          'price_rub':1240,'delivery_days_min':2,'delivery_days_max':3},
    {'company_name':'СДЭК',    'destination':'Екатеринбург',    'price_rub':1580,'delivery_days_min':3,'delivery_days_max':4},
    {'company_name':'СДЭК',    'destination':'Новосибирск',     'price_rub':1950,'delivery_days_min':4,'delivery_days_max':5},
    {'company_name':'СДЭК',    'destination':'Краснодар',       'price_rub':1380,'delivery_days_min':3,'delivery_days_max':4},
    {'company_name':'СДЭК',    'destination':'Санкт-Петербург', 'price_rub': 980,'delivery_days_min':2,'delivery_days_max':3},
    {'company_name':'СДЭК',    'destination':'Самара',          'price_rub':1120,'delivery_days_min':2,'delivery_days_max':3},
    {'company_name':'СДЭК',    'destination':'Ростов-на-Дону',  'price_rub':1450,'delivery_days_min':3,'delivery_days_max':4},
    {'company_name':'СДЭК',    'destination':'Уфа',             'price_rub':1680,'delivery_days_min':3,'delivery_days_max':5},
    {'company_name':'СДЭК',    'destination':'Пермь',           'price_rub':1520,'delivery_days_min':3,'delivery_days_max':4},
    {'company_name':'СДЭК',    'destination':'Воронеж',         'price_rub': 890,'delivery_days_min':1,'delivery_days_max':2},
    {'company_name':'Возовоз', 'destination':'Казань',          'price_rub':1090,'delivery_days_min':None,'delivery_days_max':None},
    {'company_name':'Возовоз', 'destination':'Екатеринбург',    'price_rub':1320,'delivery_days_min':None,'delivery_days_max':None},
    {'company_name':'Возовоз', 'destination':'Новосибирск',     'price_rub':1780,'delivery_days_min':None,'delivery_days_max':None},
    {'company_name':'Возовоз', 'destination':'Краснодар',       'price_rub':1210,'delivery_days_min':None,'delivery_days_max':None},
    {'company_name':'Возовоз', 'destination':'Санкт-Петербург', 'price_rub': 850,'delivery_days_min':None,'delivery_days_max':None},
    {'company_name':'Возовоз', 'destination':'Самара',          'price_rub': 990,'delivery_days_min':None,'delivery_days_max':None},
    {'company_name':'Возовоз', 'destination':'Ростов-на-Дону',  'price_rub':1290,'delivery_days_min':None,'delivery_days_max':None},
    {'company_name':'Возовоз', 'destination':'Уфа',             'price_rub':1540,'delivery_days_min':None,'delivery_days_max':None},
    {'company_name':'Возовоз', 'destination':'Пермь',           'price_rub':1380,'delivery_days_min':None,'delivery_days_max':None},
    {'company_name':'Возовоз', 'destination':'Воронеж',         'price_rub': 780,'delivery_days_min':None,'delivery_days_max':None},
])
tariffs[['delivery_days_min','delivery_days_max']] = tariffs[['delivery_days_min','delivery_days_max']].apply(pd.to_numeric, errors='coerce')

contractors = pd.DataFrame([
    {'partner':'АгроТранс',        'type':'Перевозчик', 'region':'Краснодар',       'routes':12,'avg_price':1180,'rating':4.7},
    {'partner':'ФермаЛогист',      'type':'Поставщик',  'region':'Воронеж',         'routes': 8,'avg_price': 950,'rating':4.5},
    {'partner':'РусАгро-Доставка', 'type':'Перевозчик', 'region':'Самара',          'routes':15,'avg_price':1320,'rating':4.3},
    {'partner':'ЭкоФерма',         'type':'Поставщик',  'region':'Москва',          'routes': 5,'avg_price': 870,'rating':4.9},
    {'partner':'ПоволжьеТранс',    'type':'Перевозчик', 'region':'Казань',          'routes':20,'avg_price':1410,'rating':4.1},
    {'partner':'СибЛогистика',     'type':'Перевозчик', 'region':'Новосибирск',     'routes':18,'avg_price':1870,'rating':4.4},
    {'partner':'УралАгро',         'type':'Поставщик',  'region':'Екатеринбург',    'routes': 7,'avg_price':1250,'rating':4.6},
    {'partner':'ЮгПоставка',       'type':'Поставщик',  'region':'Ростов-на-Дону',  'routes':11,'avg_price':1100,'rating':4.8},
    {'partner':'СеверТранс',       'type':'Перевозчик', 'region':'Санкт-Петербург', 'routes':14,'avg_price':1020,'rating':4.2},
    {'partner':'КамаЛогист',       'type':'Перевозчик', 'region':'Пермь',           'routes': 9,'avg_price':1390,'rating':4.5},
    {'partner':'ВолгаФрэш',        'type':'Поставщик',  'region':'Самара',          'routes': 6,'avg_price': 920,'rating':4.7},
    {'partner':'УфаКарго',         'type':'Перевозчик', 'region':'Уфа',             'routes':10,'avg_price':1560,'rating':4.0},
])

# ── ГРАФИК 1: Тарифы СДЭК vs Возовоз ────────────────────────────────────────
pivot = tariffs.pivot_table(index='destination', columns='company_name', values='price_rub').reset_index()
pivot = pivot.sort_values('СДЭК')
pivot['diff'] = pivot['СДЭК'] - pivot['Возовоз']
pivot['diff_pct'] = (pivot['diff'] / pivot['Возовоз'] * 100).round(1)
x, w = range(len(pivot)), 0.38
fig, ax = plt.subplots(figsize=(13, 5))
b1 = ax.bar([i-w/2 for i in x], pivot['СДЭК'],    w, label='СДЭК',    color=ORANGE, edgecolor='white', zorder=3)
b2 = ax.bar([i+w/2 for i in x], pivot['Возовоз'], w, label='Возовоз', color=TEAL,   edgecolor='white', zorder=3)
ax.bar_label(b1, fmt='%.0f ₽', padding=3, fontsize=8); ax.bar_label(b2, fmt='%.0f ₽', padding=3, fontsize=8)
ax.set_xticks(list(x)); ax.set_xticklabels(pivot['destination'], rotation=20, ha='right')
ax.set_title('Тарифы СДЭК vs Возовоз по маршрутам из Москвы, 5 кг', fontsize=13, fontweight='bold')
ax.set_xlabel('Город назначения'); ax.set_ylabel('Стоимость, руб.')
ax.yaxis.set_major_formatter(mticker.FuncFormatter(lambda v,_: f'{int(v):,}'))
ax.legend(fontsize=11, framealpha=0); ax.grid(axis='y', alpha=0.3); ax.spines[['top','right']].set_visible(False)
plt.tight_layout(); plt.show()

# ── ГРАФИК 2: Разница % ──────────────────────────────────────────────────────
pivot_s = pivot.sort_values('diff_pct')
fig, ax = plt.subplots(figsize=(13, 4))
bars = ax.bar(pivot_s['destination'], pivot_s['diff_pct'], color=TEAL, edgecolor='white', zorder=3)
for bar, rub in zip(bars, pivot_s['diff']):
    ax.text(bar.get_x()+bar.get_width()/2, bar.get_height()+0.3, f'+{int(rub)} ₽', ha='center', fontsize=9)
ax.axhline(pivot_s['diff_pct'].mean(), color=ORANGE, linestyle='--', linewidth=1.8, label=f"Среднее: +{pivot_s['diff_pct'].mean():.1f}%")
ax.set_title('СДЭК дороже Возовоза на каждом маршруте', fontsize=13, fontweight='bold')
ax.set_xlabel('Маршрут'); ax.set_ylabel('Надбавка СДЭК, %')
ax.tick_params(axis='x', rotation=20); ax.legend(framealpha=0, loc='lower right')
ax.grid(axis='y', alpha=0.3); ax.spines[['top','right']].set_visible(False)
plt.tight_layout(); plt.show()

# ── ГРАФИК 3: Сроки СДЭК ────────────────────────────────────────────────────
cdek = tariffs[tariffs['company_name']=='СДЭК'].sort_values('price_rub').reset_index(drop=True)
fig, ax = plt.subplots(figsize=(13, 4))
ax.bar(cdek['destination'], cdek['delivery_days_min'], color=TEAL3, edgecolor='white', label='Мин. срок', zorder=3)
ax.bar(cdek['destination'], cdek['delivery_days_max']-cdek['delivery_days_min'], bottom=cdek['delivery_days_min'], color=TEAL, edgecolor='white', label='+ доп. дни', zorder=3)
for idx, row in cdek.iterrows():
    ax.text(idx, row['delivery_days_max']+0.1, f"{int(row['delivery_days_min'])}-{int(row['delivery_days_max'])} дн.", ha='center', fontsize=9)
ax.set_title('Сроки доставки СДЭК (Возовоз сроки не раскрывает)', fontsize=13, fontweight='bold')
ax.set_xlabel('Маршрут'); ax.set_ylabel('Дней')
ax.tick_params(axis='x', rotation=20); ax.legend(framealpha=0); ax.set_ylim(0, 7)
ax.grid(axis='y', alpha=0.3); ax.spines[['top','right']].set_visible(False)
plt.tight_layout(); plt.show()

# ── ГРАФИК 4: Структура контрагентов ────────────────────────────────────────
tc = contractors['type'].value_counts()
fig, ax = plt.subplots(figsize=(6, 6))
ax.pie(tc.values, labels=tc.index, autopct='%1.0f%%', colors=[TEAL, ORANGE], startangle=90,
       textprops={'fontsize':13}, wedgeprops={'edgecolor':'white','linewidth':3})
ax.set_title('Структура контрагентов\n(перевозчики vs поставщики)', fontsize=13, fontweight='bold')
plt.tight_layout(); plt.show()

# ── ГРАФИК 5: Цена vs Рейтинг ───────────────────────────────────────────────
fig, ax = plt.subplots(figsize=(11, 5))
colors_b = [TEAL if t=='Перевозчик' else ORANGE for t in contractors['type']]
ax.scatter(contractors['avg_price'], contractors['rating'], s=contractors['routes']*18, c=colors_b,
           alpha=0.8, edgecolors='white', linewidths=1.5, zorder=3)
for _, row in contractors.iterrows():
    ax.annotate(row['partner'], (row['avg_price'], row['rating']),
                textcoords='offset points', xytext=(7,4), fontsize=8, color='#333')
ax.set_title('Контрагенты: цена vs рейтинг (размер пузыря — кол-во маршрутов)', fontsize=13, fontweight='bold')
ax.set_xlabel('Средняя цена, руб.'); ax.set_ylabel('Рейтинг')
ax.set_ylim(3.8, 5.15); ax.grid(linestyle='--', alpha=0.2); ax.spines[['top','right']].set_visible(False)
ax.legend(handles=[mpatches.Patch(facecolor=TEAL, label='Перевозчик'),
                   mpatches.Patch(facecolor=ORANGE, label='Поставщик')], framealpha=0)
plt.tight_layout(); plt.show()

# ── ГРАФИК 6: Топ по маршрутам ───────────────────────────────────────────────
top = contractors.sort_values('routes', ascending=True)
fig, ax = plt.subplots(figsize=(10, 5))
colors_h = [TEAL if t=='Перевозчик' else ORANGE for t in top['type']]
bars = ax.barh(top['partner'], top['routes'], color=colors_h, edgecolor='white', zorder=3)
ax.bar_label(bars, fmt='%d', padding=4, fontsize=9)
ax.set_title('Активность контрагентов: количество маршрутов', fontsize=13, fontweight='bold')
ax.set_xlabel('Маршрутов'); ax.grid(axis='x', alpha=0.3); ax.spines[['top','right']].set_visible(False)
ax.legend(handles=[mpatches.Patch(facecolor=TEAL, label='Перевозчик'),
                   mpatches.Patch(facecolor=ORANGE, label='Поставщик')], framealpha=0, loc='lower right')
plt.tight_layout(); plt.show()

# ── ГРАФИК 7: Цены по регионам ───────────────────────────────────────────────
rp = contractors.groupby('region')['avg_price'].mean().sort_values(ascending=False).reset_index()
fig, ax = plt.subplots(figsize=(11, 4))
bars = ax.bar(rp['region'], rp['avg_price'], color=TEAL, edgecolor='white', zorder=3)
ax.bar_label(bars, fmt='%.0f руб.', padding=4, fontsize=9)
ax.set_title('Средняя стоимость доставки у партнёров по регионам', fontsize=13, fontweight='bold')
ax.set_xlabel('Регион'); ax.set_ylabel('Средняя цена, руб.')
ax.tick_params(axis='x', rotation=25)
ax.yaxis.set_major_formatter(mticker.FuncFormatter(lambda v,_: f'{int(v):,}'))
ax.grid(axis='y', alpha=0.3); ax.spines[['top','right']].set_visible(False)
plt.tight_layout(); plt.show()

# ── ВЫВОДЫ ───────────────────────────────────────────────────────────────────
best = contractors.sort_values(['rating','avg_price'], ascending=[False,True]).iloc[0]
print("=== КОНКУРЕНТЫ ===")
print(f"СДЭК дороже Возовоза в среднем на: {pivot['diff_pct'].mean():.1f}%")
print(f"Максимальная разница: {int(pivot['diff'].max())} руб. ({pivot.loc[pivot['diff'].idxmax(),'destination']})")
print("\n=== КОНТРАГЕНТЫ ===")
print(f"Лучший партнёр: {best['partner']} — рейтинг {best['rating']}, цена {best['avg_price']} руб.")
print(f"Самый активный: {contractors.sort_values('routes',ascending=False).iloc[0]['partner']}")
