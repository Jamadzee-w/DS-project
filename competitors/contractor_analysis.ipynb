%pip install pandas matplotlib
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib.patches as mpatches
import matplotlib.ticker as mticker
%matplotlib inline
plt.rcParams['figure.dpi'] = 110
TEAL = '#01696f'; ORANGE = '#e07b39'
contractors = pd.DataFrame([
    {"partner": "АгроТранс",        "type": "Перевозчик", "region": "Краснодар",       "routes": 12, "avg_price": 1180, "rating": 4.7},
    {"partner": "ФермаЛогист",      "type": "Поставщик",  "region": "Воронеж",         "routes":  8, "avg_price":  950, "rating": 4.5},
    {"partner": "РусАгро-Доставка", "type": "Перевозчик", "region": "Самара",          "routes": 15, "avg_price": 1320, "rating": 4.3},
    {"partner": "ЭкоФерма",         "type": "Поставщик",  "region": "Москва",          "routes":  5, "avg_price":  870, "rating": 4.9},
    {"partner": "ПоволжьеТранс",    "type": "Перевозчик", "region": "Казань",          "routes": 20, "avg_price": 1410, "rating": 4.1},
    {"partner": "СибЛогистика",     "type": "Перевозчик", "region": "Новосибирск",     "routes": 18, "avg_price": 1870, "rating": 4.4},
    {"partner": "УралАгро",         "type": "Поставщик",  "region": "Екатеринбург",    "routes":  7, "avg_price": 1250, "rating": 4.6},
    {"partner": "ЮгПоставка",       "type": "Поставщик",  "region": "Ростов-на-Дону",  "routes": 11, "avg_price": 1100, "rating": 4.8},
    {"partner": "СеверТранс",       "type": "Перевозчик", "region": "Санкт-Петербург", "routes": 14, "avg_price": 1020, "rating": 4.2},
    {"partner": "КамаЛогист",       "type": "Перевозчик", "region": "Пермь",           "routes":  9, "avg_price": 1390, "rating": 4.5},
    {"partner": "ВолгаФрэш",        "type": "Поставщик",  "region": "Самара",          "routes":  6, "avg_price":  920, "rating": 4.7},
    {"partner": "УфаКарго",         "type": "Перевозчик", "region": "Уфа",             "routes": 10, "avg_price": 1560, "rating": 4.0},
])
contractors.head()
tc = contractors['type'].value_counts()
fig, ax = plt.subplots(figsize=(6,6))
ax.pie(tc.values, labels=tc.index, autopct='%1.0f%%', colors=[TEAL, ORANGE],
       startangle=90, textprops={'fontsize':13}, wedgeprops={'edgecolor':'white','linewidth':3})
ax.set_title('Структура контрагентов\n(перевозчики vs поставщики)', fontsize=13, fontweight='bold')
plt.tight_layout(); plt.show()
fig, ax = plt.subplots(figsize=(11,5))
colors_b = [TEAL if t=='Перевозчик' else ORANGE for t in contractors['type']]
ax.scatter(contractors['avg_price'], contractors['rating'],
           s=contractors['routes']*18, c=colors_b, alpha=0.8, edgecolors='white', linewidths=1.5, zorder=3)
for _, row in contractors.iterrows():
    ax.annotate(row['partner'], (row['avg_price'], row['rating']),
                textcoords='offset points', xytext=(7,4), fontsize=8, color='#333')
ax.set_title('Контрагенты: цена vs рейтинг (размер пузыря — кол-во маршрутов)', fontsize=13, fontweight='bold')
ax.set_xlabel('Средняя цена, руб.'); ax.set_ylabel('Рейтинг')
ax.set_ylim(3.8, 5.15); ax.grid(linestyle='--', alpha=0.2); ax.spines[['top','right']].set_visible(False)
ax.legend(handles=[mpatches.Patch(facecolor=TEAL, label='Перевозчик'),
                   mpatches.Patch(facecolor=ORANGE, label='Поставщик')], framealpha=0)
plt.tight_layout(); plt.show()
top = contractors.sort_values('routes', ascending=True)
fig, ax = plt.subplots(figsize=(10,5))
colors_h = [TEAL if t=='Перевозчик' else ORANGE for t in top['type']]
bars = ax.barh(top['partner'], top['routes'], color=colors_h, edgecolor='white', zorder=3)
ax.bar_label(bars, fmt='%d', padding=4, fontsize=9)
ax.set_title('Активность контрагентов: количество маршрутов', fontsize=13, fontweight='bold')
ax.set_xlabel('Маршрутов'); ax.grid(axis='x', alpha=0.3); ax.spines[['top','right']].set_visible(False)
ax.legend(handles=[mpatches.Patch(facecolor=TEAL, label='Перевозчик'),
                   mpatches.Patch(facecolor=ORANGE, label='Поставщик')], framealpha=0, loc='lower right')
plt.tight_layout(); plt.show()
